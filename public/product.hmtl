<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Products - Aladdin Tech World</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f7fb;
      color: #111;
    }

    header {
      background: #050b18;
      color: white;
      padding: 18px;
      text-align: center;
    }

    header h1 {
      color: #2196f3;
      margin-bottom: 12px;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin: 0 8px;
      font-size: 14px;
    }

    nav a:hover {
      color: #2196f3;
    }

    .hero {
      background: linear-gradient(135deg, #050b18, #1565c0);
      color: white;
      text-align: center;
      padding: 45px 20px;
    }

    .hero h2 {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .hero p {
      font-size: 16px;
    }

    .container {
      max-width: 1100px;
      margin: 30px auto;
      padding: 20px;
    }

    .search-box {
      margin-bottom: 25px;
      text-align: center;
    }

    .search-box input {
      width: 100%;
      max-width: 600px;
      padding: 14px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }

    .product {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 3px 12px rgba(0,0,0,0.1);
      transition: 0.2s;
    }

    .product:hover {
      transform: translateY(-4px);
    }

    .product img {
      width: 100%;
      height: 190px;
      object-fit: cover;
      background: #eee;
    }

    .product-content {
      padding: 16px;
    }

    .product h3 {
      margin-bottom: 8px;
      font-size: 19px;
    }

    .description {
      color: #666;
      font-size: 14px;
      min-height: 40px;
      margin-bottom: 10px;
    }

    .price {
      color: #1565c0;
      font-size: 20px;
      font-weight: bold;
      margin-bottom: 12px;
    }

    button {
      border: none;
      border-radius: 7px;
      padding: 10px 14px;
      cursor: pointer;
      font-size: 14px;
    }

    .cart-btn {
      background: #2196f3;
      color: white;
      width:
